# ─── Supabase ────────────────────────────────────────────────────────────────
# Leave blank to run the app in DEMO MODE (mock fighter, no persistence, no auth).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Where magic-link emails redirect back to.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Vision (Gym Mode) ───────────────────────────────────────────────────────
# Leave blank to serve deterministic mock OCR / nutrition payloads.
ANTHROPIC_API_KEY=
# Spec calls for Sonnet. claude-sonnet-5 is the current Sonnet-tier ID.
ANTHROPIC_MODEL=claude-sonnet-5

# ─── Push reminders (THE SLOT) ───────────────────────────────────────────────
# Without these the app is pull-only: the slot phase machine (T-90 approaching,
# T-30 imminent) only renders for someone who already opened the app — which is
# never the person deciding not to come.
#
# Generate a key pair once:   npx web-push generate-vapid-keys
# The public key is safe to expose; the private key signs and must not be.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:coach@yourgym.com

# ─── Speech-to-text (meal voice notes) ───────────────────────────────────────
# Claude does not accept audio on the Messages API, so a voice note has to be
# transcribed before the transcript can ride along with the photo. Leave both
# blank to serve mock transcripts — the whole flow still works without a key.
#
# ElevenLabs is tried first: this is Malay-English code-switching, not en-US,
# and multilingual accuracy is the binding constraint. Set STT_PROVIDER to pin
# one explicitly.
ELEVENLABS_API_KEY=
OPENAI_API_KEY=
# elevenlabs | openai   (optional; otherwise whichever key is present)
STT_PROVIDER=

# ─── MediaPipe (Home Mode) ───────────────────────────────────────────────────
# Override to self-host the WASM bundle + pose model instead of using the CDN.
NEXT_PUBLIC_MEDIAPIPE_WASM=https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision@0.10.18/wasm
NEXT_PUBLIC_POSE_MODEL=https://storage.googleapis.com/mediapipe-models/pose_landmarker/pose_landmarker_lite/float16/1/pose_landmarker_lite.task
